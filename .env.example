MARKET_DATA_PROVIDER=polygon

# Proven research/backfill provider.
POLYGON_API_KEY=

# Optional Public market data. Current live probe: DAY/ONE_MINUTE works, but
# multi-day ONE_MINUTE periods return 400, so keep Polygon as the default for
# research/backfill until Public's 1-minute history is proven end-to-end.
PUBLIC_SECRET_TOKEN=
PUBLIC_ACCESS_TOKEN=
PUBLIC_API_BASE_URL=https://api.public.com
PUBLIC_AUTH_ENDPOINT=https://api.public.com/userapiauthservice/personal/access-tokens
PUBLIC_BARS_PERIOD=FIVE_YEARS
PUBLIC_BARS_AGGREGATION=ONE_MINUTE
PUBLIC_INSTRUMENT_TYPE=EQUITY

# Google Sheets — Strategy_Catalog write (optional; skip if no service account)
GOOGLE_API_CREDENTIALS_PATH=/path/to/google-credentials.json
STRATEGY_CATALOG_SHEET_ID=your_spreadsheet_id_here
STRATEGY_CATALOG_SHEET_NAME=Strategy_Catalog
